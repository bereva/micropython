CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Specific partion table to enable the flash encryption of the file system
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-4MiBplus-xcore.csv"

# --- Change this along with the appropriate partion table to allow booloader info logging ---
# CONFIG_PARTITION_TABLE_OFFSET=0x10000
# CONFIG_BOOTLOADER_LOG_LEVEL_INFO=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y

# --- Disable ESP-IDF logging ---
# CONFIG_ESP_CONSOLE_NONE=y
# CONFIG_LOG_DEFAULT_LEVEL_NONE=y

# --- Bootloader speed optimizations ---
# CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_PERF=y

# --- Secure Boot V2 (RSA) ---
CONFIG_SECURE_BOOT=y
CONFIG_SECURE_BOOT_V2_ENABLED=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_SIGNED_ON_BOOT=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=y
CONFIG_SECURE_BOOT_SIGNING_KEY="secure_boot_signing_key_rsa.pem"

# --- Change this to enable/disable the Flash Encryption (Development Mode) ---
CONFIG_SECURE_FLASH_ENC_ENABLED=y
CONFIG_SECURE_FLASH_ENCRYPTION_MODE_DEVELOPMENT=y
CONFIG_SECURE_FLASH_ENCRYPTION_AES128=y
CONFIG_SECURE_FLASH_UART_BOOTLOADER_ALLOW_ENC=y
# CONFIG_SECURE_FLASH_UART_BOOTLOADER_ALLOW_CACHE is not set
CONFIG_SECURE_FLASH_CHECK_ENC_EN_IN_APP=y

# --- USB and ROM Download Mode ---
CONFIG_SECURE_BOOT_INSECURE=n

# --- Other security ---
CONFIG_SECURE_ENABLE_SECURE_ROM_DL_MODE=n
CONFIG_SECURE_INSECURE_ALLOW_DL_MODE=y
CONFIG_SECURE_FLASH_HAS_WRITE_PROTECTION_CACHE=y
